# Internal backend URL: never expose this as NEXT_PUBLIC_*
BACKEND_URL=http://localhost:3001
# Exact OIDC issuer (must match backend OIDC_ISSUER)
OIDC_ISSUER=https://idp.example/realms/lms
OIDC_CLIENT_ID=lms-web
# Add only for confidential client; not required for public + PKCE
OIDC_CLIENT_SECRET=
# Base64-encoded 32-byte key: openssl rand -base64 32
SESSION_SECRET_BASE64=REPLACE_ME
# Full external origin for callback; must be registered at IdP
APP_ORIGIN=http://localhost:3000
