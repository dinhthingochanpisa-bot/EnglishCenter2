NODE_ENV=development
PORT=3001
# Runtime uses app_runtime; no global tenant/user SELECT grants.
DATABASE_URL=postgresql://app_runtime:REPLACE@localhost:5432/lms_crm
# Identity connection: SELECT on platform_users and tenants ONLY, no tenant business tables.
IDENTITY_DATABASE_URL=postgresql://identity_reader:REPLACE@localhost:5432/lms_crm
# Provisioning connection: restricted operator; never run with app_runtime credentials.
PROVISIONING_DATABASE_URL=postgresql://platform_operator:REPLACE@localhost:5432/lms_crm
OIDC_ISSUER=https://your-identity-provider.example/realms/lms
OIDC_AUDIENCE=lms-api
OIDC_JWKS_URL=https://your-identity-provider.example/realms/lms/protocol/openid-connect/certs
# Privileged platform admin account subjects explicitly provisioned out of band.
PLATFORM_ADMIN_SUBJECTS=
# Never allow demo auth to production.

# Public QR intake disabled until rate limiting, privacy notice, and deployment protections are verified.
PUBLIC_INTAKE_ENABLED=false
PUBLIC_FRONTEND_URL=http://localhost:3000
