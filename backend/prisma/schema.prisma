 leadId String @map("lead_id") @db.Uuid
 sourceId String @map("source_id") @db.Uuid
 campaignId String? @map("campaign_id") @db.Uuid
 touchType String @map("touch_type") @db.VarChar(40)
 occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
 @@id([id])
 @@unique([tenantId,id])
 @@index([tenantId,leadId,occurredAt])
 @@map("crm_lead_touches")
}
model CrmLeadActivity {
 id String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 tenantId String @map("tenant_id") @db.Uuid
 leadId String @map("lead_id") @db.Uuid
 actorUserId String @map("actor_user_id") @db.Uuid
 kind String @db.VarChar(35)
 note String
 outcome String? @db.VarChar(60)
 followupAt DateTime? @map("followup_at") @db.Timestamptz(6)
 occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
 @@id([id])
 @@unique([tenantId,id])
 @@index([tenantId,leadId,occurredAt])
 @@map("crm_lead_activities")
}
model CrmCheckin {
 id String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
 tenantId String @map("tenant_id") @db.Uuid
 personId String @map("person_id") @db.Uuid
 studentId String? @map("student_id") @db.Uuid
 leadId String? @map("lead_id") @db.Uuid
 branchId String @map("branch_id") @db.Uuid
 sourceId String @map("source_id") @db.Uuid
 status String @default("DRAFT") @db.VarChar(25)
 purpose String? @db.VarChar(160)
 checkedInAt DateTime @default(now()) @map("checked_in_at") @db.Timestamptz(6)
 completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
 receivedByUserId String @map("received_by_user_id") @db.Uuid
 createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
